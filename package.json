{
  "name": "nextjs-lens",
  "version": "0.4.1",
  "description": "Deep Next.js analysis for Claude Code (MCP server) and import policy checks for CI: route trees, server/client boundaries, auth coverage, dead exports, and enforceable client-bundle rules.",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "nextjs-lens": "dist/cli.js"
  },
  "files": [
    "dist",
    "knowledge",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shanewin/nextjs-lens.git"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsc --watch",
    "test": "tsc && node --test test/*.test.mjs",
    "fetch-docs": "npx tsx scripts/fetch-docs.ts",
    "snapshot": "tsc && node scripts/snapshot.mjs",
    "check": "tsc && node scripts/check.mjs",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "mcp",
    "claude",
    "codebase",
    "analysis",
    "nextjs",
    "next.js",
    "app-router",
    "server-components",
    "policy",
    "ci",
    "sarif"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "typescript": "^5.5.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  }
}
